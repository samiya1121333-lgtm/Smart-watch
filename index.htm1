<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Watch Shop</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}

body{
background:#0f0f0f;
color:white;
}

header{
background:black;
padding:20px;
text-align:center;
border-bottom:2px solid orange;
}

header h1{
font-size:32px;
color:orange;
}

header p{
margin-top:5px;
color:#ccc;
}

.hero{
padding:40px 20px;
text-align:center;
}

.hero h2{
font-size:28px;
margin-bottom:10px;
}

.hero p{
color:#aaa;
}

.btn{
display:inline-block;
margin-top:20px;
padding:12px 25px;
background:orange;
color:black;
text-decoration:none;
border-radius:8px;
font-weight:bold;
}

.products{
padding:30px 20px;
}

.products h2{
text-align:center;
margin-bottom:25px;
color:orange;
}

.product-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.card{
background:#1b1b1b;
padding:15px;
border-radius:15px;
text-align:center;
box-shadow:0 0 10px rgba(255,165,0,0.3);
}

.card img{
width:100%;
border-radius:10px;
}

.card h3{
margin-top:15px;
}

.price{
color:orange;
font-size:22px;
margin:10px 0;
}

.order-btn{
display:inline-block;
padding:10px 20px;
background:orange;
color:black;
text-decoration:none;
border-radius:8px;
font-weight:bold;
}

.contact{
padding:40px 20px;
text-align:center;
background:#111;
margin-top:40px;
}

.contact h2{
color:orange;
margin-bottom:15px;
}

footer{
text-align:center;
padding:15px;
background:black;
color:#777;
}

</style>

</head>
<body>

<header>
<h1>Smart Watch Shop</h1>
<p>Electronic Gadget Collection</p>
</header>

<section class="hero">
<h2>Premium Smart Watch Collection</h2>
<p>Stylish & Modern Smart Watches Available</p>

<a class="btn" href="https://wa.me/8801826033155">
Order Now
</a>

</section>

<section class="products">

<h2>Our Products</h2>

<div class="product-grid">

<div class="card">
<img src="watch1.jpg" alt="">
<h3>Black Metal Smart Watch</h3>
<p class="price">৳1499</p>

<a class="order-btn"
href="https://wa.me/8801826033155">
Buy Now
</a>
</div>

<div class="card">
<img src="watch2.jpg" alt="">
<h3>Rugged Nylon Strap Watch</h3>
<p class="price">৳1699</p>

<a class="
